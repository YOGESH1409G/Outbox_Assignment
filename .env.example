# Postgres (used by Prisma)
DATABASE_URL="postgresql://outbox:outbox@localhost:5433/outbox_scheduler?schema=public"

# Redis (used by BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6380

# Server
PORT=4000

# Number of fake Ethereal sender accounts to create/seed on first boot.
# Ethereal rate-limits/pools test-account creation, so keep this modest (2-3);
# the seeder retries with backoff and logs a warning if it can't reach the target.
SENDER_COUNT=2

# BullMQ worker concurrency (how many jobs processed in parallel)
WORKER_CONCURRENCY=5

# Minimum delay enforced between individual email sends, queue-wide (ms)
MIN_DELAY_MS=2000

# Hourly rate limits (0 = unlimited). Configurable, never hardcoded.
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# How often (ms) the reconciliation sweep re-runs after boot, in addition to the startup pass. 0 disables the interval.
RECONCILE_INTERVAL_MS=60000
